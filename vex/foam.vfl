int segments = 700;
for (int band = 0; band < 3; band++)
{
    int start = band*(segments+1)*3;
    for (int i = 0; i <= segments; i++)
    for (int edge = 0; edge < 3; edge++)
    {
        float x = fit(i,0,segments,-180,180);
        float distance = .45+band*3.6 + sin(x*.22+band)*(.18+band*.32);
        float width = (.42+band*.12)*fit01(noise(set(x*.7,band*2,0)),.3,1);
        distance += (edge-1)*width;
        float z = shoreline(x)-distance;
        float y = sea_height(x,distance)+.028;
        int p = addpoint(0,set(x,y,z));
        setpointattrib(0,"Cd",p,set(.82,.91,.86));
        float gaps = smooth(.23,.61,noise(set(x*.23,band*3,13)));
        float fade = edge==1 ? gaps*(.9-band*.14) : 0;
        setpointattrib(0,"Alpha",p,fade);
    }
    for (int i = 0; i < segments; i++)
    for (int edge = 0; edge < 2; edge++)
    {
        int a = start+i*3+edge;
        addprim(0,"poly",array(a,a+3,a+4,a+1));
    }
}
