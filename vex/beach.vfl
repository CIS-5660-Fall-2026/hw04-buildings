int cols = 160;
int rows = 90;
for (int j = 0; j <= rows; j++)
for (int i = 0; i <= cols; i++)
{
    float u = fit(i,0,cols,-1,1);
    float x = sign(u)*pow(abs(u),1.5)*300;
    float distance = 240*pow(float(j)/rows,1.5);
    float z = shoreline(x)+distance;
    float y = lerp(-.68,-.34,smooth(0,7,distance));
    y += (noise(set(x*.14,z*.14,8))-.5)*.13*smooth(3,12,distance);
    vector dry = set(.69,.54,.33);
    vector wet = set(.41,.31,.19);
    vector color = lerp(wet,dry,smooth(.1,3.2,distance));
    color *= fit01(noise(set(x*.7,z*.7,5)),.97,1.03);
    int p = addpoint(0,set(x,y,z));
    setpointattrib(0,"Cd",p,color);
    setpointattrib(0,"uv",p,set(x*.1,z*.1,0));
}
for (int j = 0; j < rows; j++)
for (int i = 0; i < cols; i++)
{
    int a = j*(cols+1)+i;
    addprim(0,"poly",array(a,a+cols+1,a+cols+2,a+1));
}
